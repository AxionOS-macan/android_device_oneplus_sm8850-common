android_app {
    name: "BypassChargingTile",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],

    certificate: "platform",
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "org.lineageos.settings.resources"
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "privapp_whitelist_com.geno.bypasschargingtile.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.geno.bypasschargingtile.xml",
    src: "permissions/privapp_whitelist_com.geno.bypasschargingtile.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
